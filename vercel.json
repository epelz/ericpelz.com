{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    { "handle": "filesystem" },
    { "src": "/([^.]+)", "dest": "/$1.html", "check": true },
    { "src": "/(.*)", "status": 404, "dest": "/404.html" }
  ]
}
