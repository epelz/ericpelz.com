    "typecheck": "tsc --noEmit",
    "prettier": "prettier --write ."
  },
  "dependencies": {
    "classnames": "^2.5.1",
    "gray-matter": "^4.0.3",
    "hono": "^4.6.14",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.0",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.0",
    "remark-rehype": "^11.0.0"
  },
  "devDependencies": {
    "@hono/node-server": "^1.13.7",
    "@tailwindcss/cli": "^4.0.3",
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^22.13.0",
    "prettier": "^3.0.2",
    "tailwindcss": "^4.0.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
